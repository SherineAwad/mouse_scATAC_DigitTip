configfile: "cellranger_config.yaml"

with open(config["samples"]) as f:
    SAMPLES = [x.strip() for x in f if x.strip()]


rule all:
    input:
        expand("cellranger/{sample}/outs/summary.json", sample=SAMPLES)


rule cellranger:
    output:
        "cellranger/{sample}/outs/summary.json"

    threads:
        config["cores"]

    shell:
        """
        {config[CELLRANGER]} count \
            --id={wildcards.sample} \
            --reference={config[REFERENCE]} \
            --fastqs={config[FASTQS]} \
            --sample={wildcards.sample} \
            --localcores={config[cores]} \
            --localmem={config[mem]}
        """
